<?php

/**
 * @file
 * Contains install and update functions for UTexas Scheduled Transitions.
 */

use Drupal\node\Entity\NodeType;
use Drupal\utexas_scheduled_transitions\Hook\Hooks;
use Drupal\utexas_scheduled_transitions\TransitionsHelper;

/**
 * Implements hook_install().
 */
function utexas_scheduled_transitions_install() {
  $hooks = new Hooks();
  $transitionsHelper = new TransitionsHelper();

  // Register every existing node bundle: the UT Drupal Kit defaults, plus
  // any site-specific content types already in place.
  foreach (array_keys(NodeType::loadMultiple()) as $bundle) {
    $transitionsHelper->registerBundle($bundle);
  }

  if (method_exists($hooks, 'applyScheduledTransitionsSettingsDefaults')) {
    $hooks->applyScheduledTransitionsSettingsDefaults();
  }

  if (method_exists($hooks, 'grantAdministerPermission')) {
    $hooks->grantAdministerPermission();
  }
}
